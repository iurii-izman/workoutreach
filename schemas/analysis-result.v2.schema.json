{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://workoutreach.invalid/schemas/analysis-result.v2.schema.json",
  "title": "Workoutreach universal-first aggregate result v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["company_name", "fact", "source_id", "source_excerpt", "source_type", "published_at", "personalization_phrase", "personalization_mode", "overlap", "offer_claim_ids", "word_count", "confidence", "decision", "warnings"],
  "properties": {
    "company_name": { "type": "string", "minLength": 1, "maxLength": 200 },
    "fact": { "type": ["string", "null"], "minLength": 1, "maxLength": 1000 },
    "source_id": { "type": "string", "pattern": "^p[0-9]{2}$" },
    "source_excerpt": { "type": "string", "minLength": 1, "maxLength": 2000 },
    "source_type": { "type": "string", "enum": ["homepage_or_other", "about", "product_or_service", "case_study", "news_or_blog", "contact"] },
    "published_at": { "type": ["string", "null"], "format": "date" },
    "personalization_phrase": { "type": "string", "minLength": 1, "maxLength": 600 },
    "personalization_mode": { "type": "string", "enum": ["PERSONALIZED", "UNIVERSAL_FALLBACK", "UNIVERSAL_ONLY"] },
    "overlap": { "type": ["string", "null"], "minLength": 1, "maxLength": 600 },
    "offer_claim_ids": { "type": "array", "minItems": 0, "maxItems": 1, "uniqueItems": true, "items": { "type": "string" } },
    "word_count": { "type": "integer", "minimum": 0, "maximum": 100 },
    "confidence": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
    "decision": { "type": "string", "enum": ["READY_FOR_REVIEW"] },
    "warnings": { "type": "array", "items": { "type": "string" } }
  }
}
