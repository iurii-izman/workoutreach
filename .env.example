# Safe example only. Copy to ignored .env and replace placeholders locally.
COMPOSE_PROJECT_NAME=workoutreach
WORKOUTREACH_ENV=dry-run
WORKOUTREACH_DOMAIN=workoutreach.localhost
GENERIC_TIMEZONE=Europe/Chisinau
TZ=UTC

OPENAI_MODE=stub
OPENAI_MODEL=gpt-5.6
OPENAI_REASONING_EFFORT=low
OPENAI_STORE=false
OPENAI_MAX_OUTPUT_TOKENS=2200
TELEGRAM_MODE=stub
MAIL_TRANSPORT=disabled
LIVE_SEND_ENABLED=false

# Secrets belong only in ignored .env or Docker Secrets, never in this file.
OPENAI_API_KEY=REPLACE_WITH_OPENAI_API_KEY
TELEGRAM_BOT_TOKEN=REPLACE_WITH_TELEGRAM_BOT_TOKEN

# External read-only CV asset. Do not copy the PDF into Git.
CV_ATTACHMENT_PATH=REPLACE_WITH_ABSOLUTE_PDF_PATH
CV_ATTACHMENT_SHA256=REPLACE_WITH_64_HEX_SHA256
CV_ATTACHMENT_FILENAME=Iurii_Izman_CV_Bitrix24_AI.pdf

ALLOWED_TELEGRAM_USER_IDS=REPLACE_WITH_TEST_USER_ID
ALLOWED_TELEGRAM_CHAT_IDS=REPLACE_WITH_TEST_CHAT_ID
REVIEW_TTL_HOURS=24
MAX_REGENERATIONS=2
MAX_PAGES=6
MAX_REDIRECTS=3
PAGE_TIMEOUT_MS=10000
JOB_TIMEOUT_MS=60000
MAX_RESPONSE_BYTES=2097152
MAX_CLEAN_TEXT_CHARS=120000
DAILY_SEND_LIMIT=0
