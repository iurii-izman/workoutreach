{$WORKOUTREACH_DOMAIN:workoutreach.localhost} {
	tls internal
	encode zstd gzip
	reverse_proxy workoutreach-n8n:5678
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"
		-Server
	}
}

{$DASHBOARD_DOMAIN:dashboard.workoutreach.localhost} {
	tls internal
	encode zstd gzip
	reverse_proxy workoutreach-dashboard:3000 {
		header_up Host {host}
	}
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"
		-Server
	}
}
