{
  "name": "workoutreach",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dry-run": "node scripts/dry-run.mjs",
    "credentials:check": "node --env-file=.env scripts/credential-audit.mjs",
    "credentials:allowlist": "node --env-file=.env scripts/credential-audit.mjs --write-single-telegram-allowlist",
    "live:preview": "node --env-file=.env scripts/live-preview.mjs",
    "test": "node --test \"tests/**/*.test.mjs\"",
    "preflight": "node scripts/preflight.mjs --mode=ci",
    "greenfield": "node scripts/greenfield-guard.mjs",
    "secrets:scan": "node scripts/secret-scan.mjs",
    "licenses": "node scripts/license-scan.mjs",
    "workflows:validate": "node scripts/validate-workflows.mjs",
    "evals:validate": "node scripts/validate-evals.mjs",
    "sbom": "node scripts/generate-sbom.mjs",
    "verify": "node scripts/verify.mjs",
    "smoke:docker": "node scripts/smoke.mjs",
    "smoke:clean-clone": "node scripts/clean-clone.mjs"
  },
  "dependencies": {
    "ajv": "8.20.0",
    "cheerio": "1.2.0",
    "ipaddr.js": "2.4.0"
  }
}
